#!/bin/sh
# End-to-end suite: brings up the Compose harness (real Traefik, accit, two whoami apps, a client
# with fixed source addresses), runs crates/e2e against it and tears it down. Needs a working
# Docker. Not part of scripts/ci.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
cargo=${CARGO:-cargo}
compose="docker compose -f $root/harness/compose.yml"

down() { $compose down -v --remove-orphans >/dev/null 2>&1 || true; }
trap down EXIT
trap 'exit 130' INT TERM

down
"$root/harness/prepare"
$compose up -d --wait --build

status=0
"$cargo" test -p e2e -- --ignored --test-threads=1 || status=$?
if [ "$status" -ne 0 ]; then
  $compose logs --no-color --tail 200 >&2 || true
fi
exit "$status"
