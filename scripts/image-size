#!/bin/sh
# Image size budget: fails when a local image is larger than MAX_MIB (default 20).
# Usage: scripts/image-size [image]   (default accit:budget)
set -eu
image=${1:-accit:budget}
max_mib=${MAX_MIB:-20}

bytes=$(docker image inspect --format '{{.Size}}' "$image")
mib=$((bytes / 1048576))
echo "$image: $mib MiB uncompressed (budget $max_mib MiB)"
[ "$mib" -le "$max_mib" ]
