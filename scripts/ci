#!/bin/sh
# The full local CI: what must pass before anything merges into staging.
# GitHub Actions does not run this on its own (budget); .github/workflows/ci.yml
# is manual-only and runs a subset.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

step() { printf '\n== %s\n' "$1"; }

step "web: sync"
# Generated and gitignored, so a fresh worktree has neither: SvelteKit's
# node_modules/$app and the Paraglide messages.
bun run --cwd apps/web prebuild >/dev/null
(cd apps/web && bunx paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide >/dev/null)
step "rust gate"
scripts/check-rust
step "client-ca script"
scripts/test-client-ca
step "lint"
bun run lint
step "format"
bun run format:check
step "typecheck"
bun run typecheck
step "unit tests"
bun run web:test:unit
step "component tests"
bun run web:test:component

printf '\nlocal CI passed\n'
