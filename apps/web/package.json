{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--use-system-ca vite dev",
    "prebuild": "svelte-kit sync",
    "build": "vite build",
    "check": "bun run typecheck",
    "preview": "NODE_OPTIONS=--use-system-ca vite preview",
    "prepare": "playwright install && svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint \"**/*.svelte\"",
    "lint:staged": "eslint --no-warn-ignored",
    "test:playwright": "playwright test",
    "test:e2e": "bun run test:playwright",
    "test:a11y": "playwright test --grep @a11y",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test": "bun run test:vitest && bun run test:e2e"
  },
  "dependencies": {
    "@accit/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@accit/config": "workspace:*",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.27.0",
    "@lucide/svelte": "^1.61.0",
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "axe-core": "^4.14.0",
    "bits-ui": "^2.20.0",
    "clsx": "^2.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "^3.1.0"
  }
}
