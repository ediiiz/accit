{
  "$schema": "https://docs.fallow.tools/schema.json",
  "ignorePatterns": [
    "apps/web/src/lib/components/ui/**",
    "tools/oxlint/anti-slop/**",
    "vendor/**",
    "target/**",
    "**/*.gen.ts"
  ],
  "ignoreDependencies": ["bits-ui", "tailwind-variants", "@internationalized/date", "paneforge"],
  "rules": {
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn"
  },
  "entry": ["tools/budget/web-budget-cli.ts", "tools/bench/bench.ts", "tools/**/*.test.ts"]
}
